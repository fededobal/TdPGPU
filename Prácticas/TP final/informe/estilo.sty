\ProvidesPackage{estilo}

% ==========================================================
%  Estilo del informe: documento carta con la estética de beamer (tema Madrid).
%  Es un documento normal (extarticle), así que las secciones fluyen una
%  detrás de otra sin saltos de página.
%  Los datos (título, autor, materia) van en main.tex.
% ==========================================================

% ---------- Idioma y codificación ----------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[spanish,es-tabla]{babel}   % es-tabla: "Tabla" en vez de "Cuadro"

% ---------- Fuente sans serif, también en las fórmulas (como beamer) ----------
\RequirePackage{amsmath}
\RequirePackage{sansmathfonts}
\renewcommand{\familydefault}{\sfdefault}

% ---------- Página ----------
% Para cambiar el margen, cambiá solo \margen: la portada lo usa también
\newlength{\margen}
\setlength{\margen}{18mm}
\RequirePackage[letterpaper, margin=\margen]{geometry}
\RequirePackage{parskip}                    % párrafos separados y sin sangría, como en beamer

% ---------- Paquetes ----------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{float}                      % [H] para fijar figuras y tablas en su lugar
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks]{hyperref}

% ---------- Colores (los mismos azules de Madrid) ----------
\definecolor{azul}{rgb}{0.2,0.2,0.7}
\colorlet{azulmedio}{azul!75!black}
\colorlet{azuloscuro}{azul!50!black}

% ---------- Datos que usan la portada y el footer ----------
\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}
\newcommand{\inserttitle}{\@title}
\newcommand{\insertsubtitle}{\@subtitle}
\newcommand{\insertauthor}{\@author}

% ---------- Secciones: barra azul como el título de los frames ----------
\setcounter{secnumdepth}{0}                 % sin números, como en las diapositivas

\newcommand{\barraseccion}[1]{%
  {\setlength{\fboxsep}{3mm}%
   \colorbox{azul}{\parbox{\dimexpr\textwidth-2\fboxsep\relax}{\color{white}\Large\strut #1}}}}
\titleformat{\section}{\normalfont}{}{0pt}{\barraseccion}
\titlespacing*{\section}{0pt}{12mm}{6mm}    % espacio antes y después de cada sección

\titleformat{\subsection}{\normalfont\large\bfseries\color{azuloscuro}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{3mm}{2mm}
\titlespacing*{\subsubsection}{0pt}{0mm}{0mm}
\newcommand{\sectionbreak}{\clearpage}   % cada \section empieza en una página nueva


% ---------- Bloques: \begin{block}{Título} ... \end{block} ----------
\newtcolorbox{block}[1]{%
  enhanced, breakable,
  colback=azul!8, colframe=azulmedio, coltitle=white,
  fonttitle=\large, title={#1},
  boxrule=0pt, arc=1.5mm,
  left=2mm, right=2mm, top=1.5mm, bottom=2mm,
  drop fuzzy shadow,
  before skip=5mm, after skip=5mm,
}

% ---------- Bloques de alerta y de ejemplo, como en beamer ----------
\colorlet{rojomadrid}{red!75!black}
\colorlet{verdemadrid}{green!50!black}

\newtcolorbox{alertblock}[1]{%
  enhanced, breakable,
  colback=red!6, colframe=rojomadrid, coltitle=white,
  fonttitle=\large, title={#1},
  boxrule=0pt, arc=1.5mm,
  left=2mm, right=2mm, top=1.5mm, bottom=2mm,
  drop fuzzy shadow,
  before skip=5mm, after skip=5mm,
}

\newtcolorbox{exampleblock}[1]{%
  enhanced, breakable,
  colback=green!6, colframe=verdemadrid, coltitle=white,
  fonttitle=\large, title={#1},
  boxrule=0pt, arc=1.5mm,
  left=2mm, right=2mm, top=1.5mm, bottom=2mm,
  drop fuzzy shadow,
  before skip=5mm, after skip=5mm,
}


% ---------- Portada ----------
\newcommand{\portada}{%
\thispagestyle{empty}%
\begin{tikzpicture}[remember picture, overlay]
  % ---- Banda superior: institución ----
  \fill[azuloscuro] (current page.north west) rectangle ([yshift=-60mm]current page.north east);
  \fill[azul] ([yshift=-60mm]current page.north west) rectangle ([yshift=-63mm]current page.north east);
  \node[anchor=west, text=white, font=\large\bfseries]
    at ([xshift=\margen,yshift=-26mm]current page.north west) {Universidad Nacional de La Plata};
  \node[anchor=west, text=white!75!azul, font=\normalsize]
    at ([xshift=\margen,yshift=-37mm]current page.north west) {Facultad de Informática};
  % Logo opcional (subilo a Overleaf y descomentá):
  % \node[anchor=east] at ([xshift=-\margen,yshift=-31mm]current page.north east)
  %   {\includegraphics[height=28mm]{logo-unlp.png}};

  % ---- Bloque central: título ----
  \node[anchor=north west, text=azul, font=\small\bfseries]
    at ([xshift=\margen,yshift=-100mm]current page.north west) {TRABAJO FINAL};
  \node[anchor=north west, text width=\textwidth, align=left, text=azuloscuro, font=\Huge\bfseries]
    (titulo) at ([xshift=\margen,yshift=-110mm]current page.north west) {\inserttitle};
  \fill[azul] ([yshift=-6mm]titulo.south west) rectangle ++(40mm,-1.5mm);
  \node[anchor=north west, text width=\textwidth, align=left, text=black!70, font=\Large]
    at ([yshift=-14mm]titulo.south west) {\insertsubtitle};

  % ---- Autor ----
  \draw[azul, line width=1.5pt] ([xshift=\margen,yshift=74mm]current page.south west) -- ++(0,-22mm);
  \node[anchor=north west, text=black!55, font=\small]
    at ([xshift={\margen+5mm},yshift=75mm]current page.south west)
  \node[anchor=north west, text=azuloscuro, font=\large\bfseries]
    at ([xshift={\margen+5mm},yshift=67mm]current page.south west) {\insertauthor};

  % ---- Banda inferior ----
  \fill[azul] ([yshift=20mm]current page.south west) rectangle ([yshift=22mm]current page.south east);
  \fill[azuloscuro] (current page.south west) rectangle ([yshift=20mm]current page.south east);
\end{tikzpicture}%
\clearpage
}

% ---------- Footer: las cajas de Madrid de borde a borde ----------
% Anchos relativos al papel: autor 20%, título 30%, materia + página 50%
\newcommand{\piedepagina}{%
  \begin{tikzpicture}[remember picture, overlay, every node/.style={text=white, font=\small}]
    \begin{scope}[shift={(current page.south west)}]
      \fill[azuloscuro] (0,0)                  rectangle ({0.2*\paperwidth},10mm);
      \fill[azulmedio]  ({0.2*\paperwidth},0)  rectangle ({0.5*\paperwidth},10mm);
      \fill[azul]       ({0.5*\paperwidth},0)  rectangle (\paperwidth,10mm);
      \node at ({0.1*\paperwidth},5mm)  {\insertauthor};
      \node at ({0.35*\paperwidth},5mm) {\inserttitle};
      \node at ({0.68*\paperwidth},5mm) {\materia};             % \materia se define en main.tex
      \node[anchor=east] at ({\paperwidth-5mm},5mm) {\thepage{} / \pageref*{LastPage}};
    \end{scope}
  \end{tikzpicture}%
}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\piedepagina}

% ---------- Código ----------
% ---------- Código ----------
\lstset{
  language=C++,
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{blue!70!black}\bfseries,
  commentstyle=\color{green!50!black}\itshape,
  morekeywords={__global__,__device__,__shared__,__syncthreads,dim3},
  numbers=left, numberstyle=\tiny\color{black!70}, breaklines=true,
  backgroundcolor=\color{azul!4},
  xleftmargin=6mm, framexleftmargin=2mm,
  aboveskip=4mm, belowskip=4mm,
  basewidth=0.52em                          % menos separación entre letras del código
}

\usetikzlibrary{decorations.pathreplacing, patterns, babel}
